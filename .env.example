ONEBOT_WS_URL=ws://host.docker.internal:3001
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token
ADMINISTRATOR_QQ=replace-with-your-qq-number
# Optional: PostgreSQL storage for successful automatic replies.
BENDAN_DATABASE_URL=postgres://dev:password@host.docker.internal:5432/devdb?sslmode=disable
# Optional but recommended: random salt for irreversible chat/sender hashes.
BENDAN_EVENT_HASH_SALT=replace-with-a-long-random-value
# Optional: add a random 500ms-1200ms delay before automatic replies. Defaults to false.
AUTOMATIC_REPLY_DELAY=false
# Optional: path to a JSON action lexicon. Defaults to ./actions.json.
ACTION_LEXICON_PATH=actions.json
